# Copy to frontend/.env. Everything prefixed VITE_ is bundled into public browser
# code: put ONLY public values here, never secrets or private keys.

# Public URL of the FastAPI backend. The WebSocket URL is derived from it
# (http -> ws, https -> wss).
VITE_API_BASE_URL=http://localhost:8000

# Optional: public site origin (e.g. https://vistara-x.example). When set, the
# production build writes sitemap.xml and a canonical URL. Leave empty if unknown.
VITE_SITE_URL=
