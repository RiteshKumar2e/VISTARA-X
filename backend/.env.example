# Copy to backend/.env and adjust. Never commit the real .env.
# development | production (production disables /docs and adds HSTS)
VISTARA_ENV=development
# Comma-separated list of allowed browser origins (CORS + WebSocket origin check).
# In production set this to your exact frontend origin, e.g. https://your-frontend.example
VISTARA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Detector on startup: simulated | yolov8 | auto (auto = yolov8 when available)
VISTARA_DETECTOR=simulated
# Path to YOLOv8 weights. Not downloaded automatically.
VISTARA_YOLO_WEIGHTS=models/yolov8n.pt
VISTARA_YOLO_CONFIDENCE=0.25
VISTARA_SIM_HZ=20
VISTARA_TELEMETRY_HZ=10
VISTARA_PERCEPTION_HZ=4
VISTARA_MAX_WS_CLIENTS=20
# Occupancy-grid cell size in metres (0.05 - 1.0)
VISTARA_GRID_RESOLUTION=0.2
# Default robot speed limit (m/s) and safety margin added to the robot radius (m)
VISTARA_MAX_SPEED=0.9
VISTARA_SAFETY_MARGIN=0.15
# Physics backend: auto | pybullet | analytic  (auto = PyBullet when installed)
VISTARA_PHYSICS=auto
# 1 opens the PyBullet GUI window (needs a desktop session); 0 = headless
VISTARA_PYBULLET_GUI=0
# DEBUG | INFO | WARNING | ERROR
VISTARA_LOG_LEVEL=INFO
# Windows: raise the backend to above-normal CPU priority (1) or leave it normal (0)
VISTARA_HIGH_PRIORITY=1

# Delivery operations: log folder, and an optional webhook that receives every
# notification as JSON (connect it to an SMS / WhatsApp / chat gateway). Empty = off.
VISTARA_OPS_DIR=
VISTARA_WEBHOOK_URL=

# Optional access keys (send as X-API-Key). Empty = open access (fine on localhost).
# Set both for any shared or networked deployment. Never put keys in frontend VITE_* variables.
VISTARA_OPERATOR_KEY=
VISTARA_ADMIN_KEY=

# Speech recognition model: tiny | base | small | medium
VISTARA_WHISPER_MODEL=base
